{
  "id": "futures-spread-fixture",
  "title": "期货双腿离线样例",
  "summary": "回放固定双腿、换月和结算事件，查看原生净值、保证金、费用及成交。",
  "kind": "external",
  "workspace_repo": "quant-futures-spread",
  "upstream_ref": "f01d6afd87ca0556d6e2f44e522cfecbf00cad56",
  "base_config": "base.yaml",
  "config_format": "yaml",
  "data_help": "使用上游仓库随附的固定合成事件与四段开平仓计划。仅验证双腿、换月及账本软件，不读取外部行情目录，不代表真实市场策略。",
  "knobs": [
    {"name": "initial_cash", "label": "初始资金（人民币，最多8位小数）", "type": "text", "max_length": 18, "pattern": "[0-9]{1,9}(?:\\.[0-9]{1,8})?", "default": "200000", "path": "account.initial_cash"},
    {"name": "random_seed", "label": "随机种子", "type": "int", "minimum": 0, "maximum": 2147483647, "default": 20200103, "path": "random_seed"}
  ],
  "argv": ["python", "-m", "qfs_certified.runner", "--config", "{config}", "--output-root", "{output}"],
  "preflight_argv": ["python", "-m", "qfs_certified.runner", "--config", "{config}", "--preflight"],
  "preflight_contract": {"schema_version": "quant-futures-spread.preflight/v1", "status_field": "status", "positive_counts": ["event_count"], "instrument_ids_required": true},
  "preflight_summary": "只读检查合约主表、事件、信号触发、初始资金和输入身份；不撮合、不创建账本。",
  "standard_view": {"run": "certified_local_sample_v1"},
  "output_dirs": ["{output}"],
  "result_files": {"nav.csv": "studio-view/nav.csv", "account.csv": "studio-view/account.csv", "positions.csv": "studio-view/positions.csv", "orders.csv": "studio-view/orders.csv", "fills.csv": "studio-view/fills.csv", "margin.csv": "studio-view/margin.csv", "costs.csv": "studio-view/costs.csv", "cash_ledger.csv": "studio-view/cash_ledger.csv"},
  "result_evidence": {"file": "studio-view/view.json", "field": "evidence_kind", "values": ["synthetic"]},
  "nav_currency": "CNY",
  "return_decimals": 4,
  "report_name": "report.html",
  "disclaimer": "固定合成样例，仅验证软件。净值按UTC事件展示，不是日线策略绩效，不发送真实订单。"
}
