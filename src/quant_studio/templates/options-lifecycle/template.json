{
  "id": "options-lifecycle",
  "title": "期权与现货联合账户",
  "summary": "使用明确的数据、时点和模型假设，生成可复查的研究报告。",
  "kind": "external",
  "workspace_repo": "quant-options",
  "runtime_key": "quant-options-market",
  "upstream_ref": "daa59c7df216c9a34a5bf9c7dfe3b9039f440bd6",
  "integration_job": "option-swaps-local",
  "base_config": "base.json",
  "config_format": "json",
  "knobs": [
    {
      "name": "rate",
      "label": "年化无风险利率",
      "path": "rate",
      "default": 0.03,
      "minimum": -1,
      "maximum": 1,
      "type": "number"
    },
    {
      "name": "hedge_lot",
      "label": "对冲最小股数",
      "path": "hedge_lot",
      "default": 1,
      "minimum": 1,
      "maximum": 10000,
      "type": "int"
    }
  ],
  "requires_snapshot": true,
  "argv": [
    "python",
    "-m",
    "quant_options.market_extensions.advanced",
    "lifecycle",
    "--bundle",
    "{snapshot}",
    "--config",
    "{config}",
    "--output",
    "{output}"
  ],
  "preflight_argv": [
    "python",
    "-m",
    "quant_options.market_extensions.advanced",
    "lifecycle",
    "--bundle",
    "{snapshot}",
    "--config",
    "{config}",
    "--preflight"
  ],
  "preflight_summary": "只读验证输入、报价时点和模型计算；不会提交订单。",
  "preflight_contract": {
    "schema_version": "quant-options.advanced-preflight/v1",
    "status_field": "software_preflight",
    "positive_counts": []
  },
  "output_dirs": [
    "{output}"
  ],
  "result_files": {
    "report.html": "report.html",
    "study.json": "study.json",
    "artifacts.json": "artifacts.json",
    "nav.csv": "nav.csv",
    "ledger.csv": "ledger.csv"
  },
  "result_evidence": {
    "file": "study.json",
    "field": "evidence_kind",
    "values": [
      "synthetic",
      "retrospective"
    ]
  },
  "report_name": "report.html",
  "disclaimer": "默认输入为合成验收样例；真实研究需替换有来源的历史输入。保证金是研究规则，清算回执仅离线核对。",
  "input_source": {
    "label": "期权历史数据包目录",
    "environment": "QUANT_OPTIONS_BUNDLE",
    "required_files": [
      "manifest.json",
      "contracts.json",
      "quotes.csv"
    ]
  },
  "data_help": "默认事件与 DEMO 期权包对应；真实数据需同时替换合约、事件、借券与对冲映射。"
}
