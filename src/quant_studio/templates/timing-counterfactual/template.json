{
  "id": "timing-counterfactual",
  "title": "择时仓位与风格反事实",
  "summary": "固定原配置，比较仓位、风格与联合干预，查看完整候选族及分折效应；全部候选禁发仓位。",
  "kind": "external",
  "workspace_repo": "quant-timing",
  "upstream_ref": "35058df73d079f951b5600154ee444ce66fe5fa6",
  "base_config": "base.json",
  "config_format": "json",
  "requires_snapshot": true,
  "input_source": {"kind": "file", "label": "择时研究配置文件", "environment": "QUANT_TIMING_CONFIG"},
  "data_help": "选择已有YAML配置。保持输入、成本、预热及后续约束，仅运行原生固定干预族，不搜索参数或发布仓位。无风格模块时只比较原策略与仓位干预。",
  "knobs": [],
  "argv": ["python", "-m", "quant_timing", "counterfactual", "--config", "{snapshot}", "--out", "{output}"],
  "preflight_argv": ["python", "-m", "quant_timing", "preflight", "--config", "{snapshot}"],
  "preflight_contract": {"schema_version": "quant-timing.preflight/v1", "status_field": "software_preflight", "positive_counts": ["rows", "symbols", "folds"]},
  "preflight_summary": "只读检查原配置、来源和结构性滚动窗口。实际研究逐个执行固定候选；任何必需候选失败，家族效应结论不可用。",
  "counterfactual_view": {"run": "."},
  "output_dirs": ["{output}"],
  "result_files": {"report.html": "report.html"},
  "result_evidence": {"file": "studio-view/view.json", "field": "evidence_kind", "values": ["synthetic", "retrospective", "user_provided", "unspecified"]},
  "report_name": "report.html",
  "disclaimer": "历史模拟解释；不选择新策略、不增加独立前向证据，所有候选禁止发布下游仓位。"
}
