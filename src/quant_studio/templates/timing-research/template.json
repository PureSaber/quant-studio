{
  "id": "timing-research",
  "title": "指数与风格择时研究",
  "summary": "读取已有配置，预检后运行原生研究，分别查看全样本曲线、滚动测试折和仓位发布状态。",
  "kind": "external",
  "workspace_repo": "quant-timing",
  "upstream_ref": "4773d8f1ef3dac9cf86f155d9fe28f112fc9d649",
  "base_config": "base.json",
  "config_format": "json",
  "requires_snapshot": true,
  "input_source": {"kind": "file", "label": "择时研究配置文件", "environment": "QUANT_TIMING_CONFIG"},
  "data_help": "选择已有YAML研究配置。输入路径仍按原配置目录及父目录解析；成本系数只缩放原费率和冲击系数，默认1保持原值。来源性质由source.evidence_kind声明，缺省显示未声明。",
  "knobs": [{"name": "cost_multiplier", "label": "原成本系数", "type": "number", "minimum": 0, "maximum": 10, "default": 1, "path": "cost_multiplier"}],
  "argv": ["python", "-m", "quant_timing", "run", "--config", "{snapshot}", "--overrides", "{config}", "--out", "{output}"],
  "preflight_argv": ["python", "-m", "quant_timing", "preflight", "--config", "{snapshot}", "--overrides", "{config}"],
  "preflight_contract": {"schema_version": "quant-timing.preflight/v1", "status_field": "software_preflight", "positive_counts": ["rows", "symbols", "folds"]},
  "preflight_summary": "只读检查来源、必需列和结构性滚动窗口；不产生信号、权重、回测或可发布仓位。有效计分、动态覆盖和最新仓位门禁在完整研究中判断。",
  "timing_view": {"run": "."},
  "output_dirs": ["{output}"],
  "result_files": {"nav.csv": "studio-view/nav.csv", "benchmark_nav.csv": "studio-view/benchmark_nav.csv", "positions.csv": "studio-view/positions.csv", "orders.csv": "studio-view/orders.csv", "costs.csv": "studio-view/costs.csv"},
  "nav_initial_value": 1,
  "result_evidence": {"file": "studio-view/view.json", "field": "evidence_kind", "values": ["synthetic", "retrospective", "user_provided", "unspecified"]},
  "result_notice": "以下曲线为描述性全区间收益，含预热期，不是滚动样本外验收曲线。净值从1开始；持仓份额、金额和费用按单位本金计算，非真实股数或货币账户。期货市值为名义敞口，不计入已投资净值。target订单仅为研究目标。",
  "result_table_titles": {"positions.csv": "单位本金模拟持仓", "orders.csv": "研究调仓目标", "costs.csv": "单位本金研究费用"},
  "result_column_labels": {"date": "日期", "timestamp": "日期", "strategy": "策略", "symbol": "标的", "quantity": "模拟份额", "market_value": "模拟金额或名义敞口", "weight": "权重", "target_weight": "目标权重", "return_weight": "上一决策收益权重", "side": "方向", "status": "状态", "slippage": "原生综合交易费用", "total_cost": "单位本金费用合计"},
  "report_name": "report.html",
  "disclaimer": "研究用途；有效计分和因果审计通过不代表正超额收益，不发送真实订单。"
}
