{
  "id": "hk-equity-daily",
  "title": "港股日频研究",
  "summary": "使用上游港股研究工具执行日频策略。",
  "kind": "external",
  "workspace_repo": "quant-hk-equity",
  "upstream_ref": "0.1.0",
  "base_config": "base.json",
  "config_format": "json",
  "knobs": [
    {"name": "initial_cash", "type": "decimal-string", "minimum_length": 4, "maximum_length": 12, "default": "1000000", "path": "initial_cash"},
    {"name": "rebalance_sessions", "type": "int", "minimum": 1, "maximum": 5, "choices": [1, 5], "default": 5, "path": "rebalance_sessions"}
  ],
  "argv": ["quant-hk", "run", "--config", "{config}", "--snapshot", "{snapshot}", "--output", "{output}"],
  "preflight_argv": ["quant-hk", "preflight", "--config", "{config}", "--snapshot", "{snapshot}"],
  "output_dirs": ["{output}"],
  "requires_snapshot": true,
  "input_source": {"label": "港股快照目录", "environment": "QUANT_HK_SNAPSHOT", "default": "data/hk-snapshot", "required_files": ["manifest.json"]},
  "nav_initial_value_key": "initial_cash",
  "result_files": {"nav.csv": "holdout/standard/returns.csv", "report.html": "report.html", "positions.csv": "holdout/standard/positions.csv", "orders.csv": "holdout/standard/orders.csv"},
  "presets": [
    {"id": "daily", "label": "日频", "values": {"rebalance_sessions": 1, "initial_cash": "1000000"}},
    {"id": "weekly-small", "label": "周频小资金", "values": {"rebalance_sessions": 5, "initial_cash": "100000"}}
  ],
  "report_name": "report.html",
  "disclaimer": "研究用途，不构成投资建议。"
}
