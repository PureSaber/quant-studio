{
  "id": "paper-sim",
  "title": "模拟盘步进研究",
  "summary": "使用固定信号驱动上游模拟盘单步运行。",
  "kind": "external",
  "workspace_repo": "quant-paper-sim",
  "upstream_ref": "0ff46a10f21c5df64a6cd77b7e941a506240dffe",
  "base_config": "base.yaml",
  "config_format": "yaml",
  "knobs": [
    {"name": "initial_capital", "type": "number", "minimum": 10000, "maximum": 1000000000, "default": 100000, "path": "initial_capital"}
  ],
  "argv": ["quant-paper", "step", "--config", "{config}"],
  "preflight_argv": ["quant-paper", "preflight", "--config", "{config}"],
  "preflight_summary": "检查模拟信号、证券身份、费用及账户前置条件；不回放成交或改写账户。",
  "output_dirs": ["state"],
  "input_paths": ["signals.path", "regime.path"],
  "presets": [
    {"id": "small", "label": "小资金", "values": {"initial_capital": 10000}},
    {"id": "standard", "label": "标准", "values": {"initial_capital": 100000}}
  ],
  "report_name": "report.html",
  "disclaimer": "研究用途，不构成投资建议。"
}
