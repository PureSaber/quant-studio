{
  "id": "global-index-basis",
  "title": "股指期货基差与期现联动",
  "summary": "匹配指数身份、币种与观察时间，分解基差及持有成本",
  "kind": "external",
  "workspace_repo": "quant-futures-spread",
  "upstream_ref": "0b63a58b271b84d975a3fb6e5e433bae4384c63e",
  "base_config": "base.json",
  "config_format": "json",
  "requires_snapshot": true,
  "input_source": {
    "label": "股指期货基差与期现联动数据目录",
    "environment": "QUANT_GLOBAL_INDEX_BASIS_INPUT",
    "required_files": [
      "manifest.json",
      "contracts.json",
      "quotes.csv"
    ]
  },
  "knobs": [],
  "argv": [
    "python",
    "-m",
    "qfs_global.workbench",
    "run",
    "--kind",
    "basis",
    "--bundle",
    "{snapshot}",
    "--config",
    "{config}",
    "--output",
    "{output}"
  ],
  "preflight_argv": [
    "python",
    "-m",
    "qfs_global.workbench",
    "preflight",
    "--kind",
    "basis",
    "--bundle",
    "{snapshot}",
    "--config",
    "{config}"
  ],
  "preflight_summary": "只读检查完整数据与账户路径",
  "output_dirs": [
    "{output}"
  ],
  "result_files": {
    "basis.csv": "basis.csv",
    "study.json": "study.json",
    "artifacts.json": "artifacts.json",
    "report.html": "report.html"
  },
  "report_name": "report.html",
  "disclaimer": "仅研究；真实资料、合成案例及市场参考分别标记。借券和保证金使用显式假设。",
  "runtime_key": "quant-futures-global",
  "preflight_contract": {
    "schema_version": "qdk.derivatives.preflight/v1",
    "status_field": "software_preflight",
    "positive_counts": [
      "rows",
      "contracts"
    ],
    "instrument_ids_required": true
  },
  "result_evidence": {
    "file": "study.json",
    "field": "evidence_kind",
    "values": [
      "synthetic",
      "retrospective"
    ]
  },
  "integration_job": "research-extensions"
}
